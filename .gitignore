# Build output
build/
dist/
*.deb
*.ddeb
*.udeb
*.buildinfo
*.changes
*.dsc
*.tar.gz
*.tar.xz
*.tar.zst
*.orig.tar.*
*.debian.tar.*
*.upload

# Per-source-package build artifacts
# Gridline keeps every source package under packages/<name>/, so debian/ never
# appears at the repository root. Staging trees created by dpkg-buildpackage are
# ignored by the gridline-* glob, which covers future binary packages without
# touching debian/source/ or debian/patches/, since neither matches the prefix.
packages/*/debian/files
packages/*/debian/tmp/
packages/*/debian/.debhelper/
packages/*/debian/*.substvars
packages/*/debian/*.debhelper
packages/*/debian/*.debhelper.log
packages/*/debian/debhelper-build-stamp
packages/*/debian/gridline-*/
# Build-time output assembled from the source tree, staged for dh_install.
packages/*/debian/generated/

# Local tooling and caches
.cache/
.venv/
node_modules/
__pycache__/
*.py[cod]

# Editor and OS noise
*.swp
*.swo
*~
.DS_Store
.idea/
.vscode/

# Logs and scratch
*.log
tmp/
scratch/

# Local secrets and machine-specific overrides
.env
.env.*
*.local
