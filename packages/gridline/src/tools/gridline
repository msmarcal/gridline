#!/bin/sh
# The Gridline command.
#
# package-delivery assigns this to gridline-tools, which until now shipped a
# directory and nothing to run. `doctor` is its first subcommand and the shape
# is meant to be the shape of the rest: the project has already said it will
# report policy that is not in effect and compositor capabilities that are
# unavailable, and both are the same kind of answer as this one.
#
# What this does not do is observe anything. It answers a question when asked,
# from what the session wrote down. Watching components over time, acting on
# what it finds, and alerting are all deliberately absent.

set -eu

STATE_RECORDER=/usr/libexec/gridline/gridline-component-state
SESSION_TARGET=gridline-session.target
SHELL_TARGET=gridline-shell.target

usage() {
    cat >&2 <<'EOF'
usage: gridline <command>

  doctor    report the components a Gridline session expects and their state

EOF
    exit 64
}

# A component's line reads as a sentence about the component, not as a dump of
# a record. Someone running this because their bar is missing should find the
# word bar.
describe() {
    name=$1
    state=$2
    blocking=$3
    at=$4

    case $state in
    started) verdict="running" ;;
    ready) verdict="ready" ;;
    stopped) verdict="stopped" ;;
    failed) verdict="failed" ;;
    absent) verdict="not installed" ;;
    *) verdict="unknown ($state)" ;;
    esac

    # Severity is said rather than implied. A reader should not have to know
    # which components are fail-safe to know whether to worry.
    #
    # ready and started are both healthy and for different reasons: started is
    # a component that is running, ready is one that is installed and runs when
    # something asks, which is the screen locker's whole life. Neither gets a
    # consequence, because there is no consequence to report.
    if [ "$state" = started ] || [ "$state" = ready ]; then
        consequence=""
    elif [ "$blocking" = yes ]; then
        consequence="  (a session will not start without it)"
    else
        consequence="  (the desktop works without it, with less)"
    fi

    # The time is part of the answer and not a detail. Every line here is a
    # last-known state, and a reader who cannot see when it was last known has
    # no way to tell a component that is running from one that was running when
    # they logged in. That difference is not hypothetical: this command
    # reported a dead authentication agent and a given-up screen lock as
    # running, for the whole of the sessions in which they died, because the
    # record was written once and the report said nothing about when.
    printf '  %-16s %-14s %s%s\n' "$name" "$verdict" "$(at_phrase "$at")" \
        "$consequence"
}

# The record's own timestamp, in words a reader can use. UTC is what the record
# carries, and converting it is the whole point: nobody reads their own
# afternoon as 15:42Z.
#
# An unreadable or missing time is said plainly rather than hidden or guessed
# at. A record from before this field existed has none, and silently printing
# the current time for it would be the exact failure this is here to end.
#
# The date is shown whenever the record is not from today, and that is not
# tidiness. A first version printed the hour and minute only, and a record from
# the previous day read as "as of 04:00", which a reader takes for four o'clock
# this morning. The same version rendered a record stamped in the year 2099 as
# "as of 00:00", which reads as the most ordinary line on the page. Both were
# this command presenting a record it could not vouch for as a current one,
# which is the defect it exists to stop making.
at_phrase() {
    [ -n "${1-}" ] || {
        printf 'at an unrecorded time'
        return 0
    }

    stamp=$(date -d "$1" '+%Y-%m-%d %H:%M' 2>/dev/null || true)
    if [ -z "$stamp" ]; then
        printf 'at %s, which is not a time this can read' "$1"
        return 0
    fi

    # A record from later than now is a clock that moved, not a component that
    # will report in. Saying so is the only honest option: the state may be
    # true, and how long it has been true is unknown.
    recorded_at=$(date -d "$1" '+%s' 2>/dev/null || true)
    if [ -n "$recorded_at" ] && [ "$recorded_at" -gt "$(date '+%s')" ]; then
        printf 'stamped %s, which is in the future' "$stamp"
        return 0
    fi

    case $stamp in
    "$(date '+%Y-%m-%d') "*) printf 'as of %s' "${stamp#* }" ;;
    *) printf 'as of %s' "$stamp" ;;
    esac
}

doctor() {
    if [ ! -x "$STATE_RECORDER" ]; then
        echo "gridline doctor: $STATE_RECORDER is not installed," \
            "so there is nothing recording what the session knows" >&2
        return 1
    fi

    records=$("$STATE_RECORDER" list 2>/dev/null || true)

    # Silence and health are different answers and must read differently. An
    # empty record means no Gridline session has run for this user since they
    # logged in, which is a fact about the machine rather than a failure of
    # this command.
    if [ -z "$records" ]; then
        echo "No Gridline session has recorded anything for this user."
        echo "This is what you see before a first login, and after logging out"
        echo "of every session, because the record lives and dies with them."
        return 0
    fi

    # Whether these records describe now or a session that has ended. Gridline's
    # own target answers it, and no unit another package owns is read: a
    # diagnostic whose correctness depends on a third party's unit internals is
    # one that breaks when that party changes its mind.
    #
    # This is said before the components and not after, because it changes how
    # every line below should be read. A record from a session that is over is
    # not wrong, it is history, and the reader is the one who needs to know
    # which they are looking at.
    if systemctl --user is-active --quiet "$SESSION_TARGET" 2>/dev/null; then
        echo "A Gridline session is running. Components it expects:"
    else
        echo "No Gridline session is running now. What the last one recorded:"
    fi
    echo

    unhealthy=0
    while read -r name state blocking at; do
        [ -n "$name" ] || continue
        describe "$name" "$state" "${blocking:-no}" "${at:-}"
        case $state in
        started | ready) ;;
        *) unhealthy=$((unhealthy + 1)) ;;
        esac
    done <<EOF
$records
EOF

    echo

    # Said once, in the footer, rather than as a qualification on every line. A
    # report that hedges each component is as useless as one that is
    # confidently wrong: a reader scanning five hedged lines learns nothing and
    # stops reading, which is the same outcome as being lied to.
    echo "Each line is the last thing the session recorded about that"
    echo "component, at the time shown. Nothing here polls: a component is"
    echo "recorded when it starts, and again when it stops or fails."

    if [ "$unhealthy" -eq 0 ]; then
        echo
        echo "Every component this session expects is accounted for."
        return 0
    fi

    echo
    printf '%s component(s) are not running.\n' "$unhealthy"
    echo "A component that is not installed can be installed; one that failed"
    echo "has its reason in the journal: journalctl --user -u <unit>"
    return 1
}

# The record is the answer, and the targets are what the record is about. This
# reads Gridline's own units to say what the session is wired to expect, and
# never reads a unit another package owns: a diagnostic whose correctness
# depends on the internals of a third party's unit is a diagnostic that breaks
# when that party changes its mind.
wiring() {
    for target in "$SESSION_TARGET" "$SHELL_TARGET"; do
        printf '%s wants: %s\n' "$target" \
            "$(systemctl --user show -p Wants --value "$target" 2>/dev/null)"
    done
}

command=${1-}
[ -n "$command" ] || usage
shift

case $command in
doctor)
    [ $# -eq 0 ] || usage
    doctor
    ;;
doctor-wiring)
    # Not advertised in the usage: this exists so that a verification can
    # compare what the record claims about severity against what the session's
    # own targets declare, without that comparison living inside doctor as a
    # second source of the same fact.
    wiring
    ;;
*)
    usage
    ;;
esac
