#!/bin/sh
# Hide the session entries the compositor's own package registers.
#
# They are on the machine because gridline-session depends on that compositor,
# not because anyone chose them: apt-mark showmanual does not list it. So
# installing one desktop offers two, and the one nobody asked for runs a session
# that inherits Gridline's keybindings and none of Gridline's components.
#
# A diversion rather than an edit or a deletion. The compositor's package keeps
# owning its file, dpkg --verify on it stays clean, its upgrades land at the
# diverted path, and removing the diversion puts the file back without anyone
# having kept a copy. See docs/package-matrix.md for why a drop-in cannot do
# this: the only directory with precedence belongs to the local administrator
# and Policy forbids a package writing there.

set -e

SESSION_DIR=/usr/share/wayland-sessions
DIVERTED_SUFFIX=.gridline-diverted

# Substituted at build time from what each adapter declares, so this file names
# no compositor. An earlier version carried the name directly, in debian/, on
# the reasoning that the isolation check excludes that directory. The exclusion
# is real and does not reach this far: its own stated reason is that packaging
# metadata must name the packages the project depends on, and a Depends is a
# recorded dependency rather than logic. A script that enumerates a named
# package and acts on the result is logic, which compositor-abstraction
# confines to the adapter layer.
COMPOSITOR_PACKAGES="@COMPOSITOR_PACKAGES@"

divert_session_entries() {
    # Enumerated from the package rather than from a list written here. A list
    # covers what was true when it was written; this covers what the package
    # owns now, which is the point of being re-run by a trigger.
    for package in $COMPOSITOR_PACKAGES; do
        dpkg -L "$package" 2>/dev/null |
            grep "^$SESSION_DIR/.*\.desktop\$"
    done |
        while IFS= read -r entry; do
            # Idempotent: a trigger fires an unpredictable number of times, and
            # re-adding an existing diversion is an error rather than a no-op.
            if dpkg-divert --list "$entry$DIVERTED_SUFFIX" | grep -q .; then
                continue
            fi
            dpkg-divert --package gridline-session \
                --divert "$entry$DIVERTED_SUFFIX" \
                --rename --add "$entry" >/dev/null
        done
}

# The desktop shell components, by unit name. None of them is compositor
# content: what makes a component compositor-specific is what it links and
# requires, which docs/component-ownership.md records measuring for each of
# these, so these names belong here rather than behind the substitution above.
SHELL_UNITS="waybar.service mako.service hyprpaper.service"

STATE_DIR=/var/lib/gridline
DISABLED_RECORD=$STATE_DIR/disabled-user-units

# Stop the shell components starting in every graphical session on the machine.
#
# Each of their packages enables its own unit from its postinst, with
# deb-systemd-helper --user enable, which puts a symlink under
# graphical-session.target.wants. That target belongs to every graphical
# session, so declaring these as dependencies makes them start under GNOME too.
# Measured there: the bar fails five times and gives up because GNOME
# implements no layer shell, and the notification daemon exits at once because
# GNOME already holds the D-Bus name. Nothing is visible, and two units are
# left failed in a session Gridline promised not to touch, for reasons that are
# accidents of the fallback desktop rather than anything Gridline arranged.
#
# This costs Gridline nothing. Upholds= and Wants= start a unit whatever its
# enabled state, which hyprpolkitagent has demonstrated since it was declared:
# it is disabled and the session target starts it.
#
# disable rather than mask. A masked unit cannot be started by anything, the
# session target included, so masking would turn this off everywhere including
# where Gridline wants it on.
#
# This is the same shape as the session-entry diversion: a reversible change to
# state another package owns, recorded where the removal can read it back. It
# differs in one way worth stating, because the postrm's own rule is to read
# back from dpkg rather than from a list. dpkg knows which diversions are ours;
# nothing knows who disabled a unit. So this writes the one record there is,
# and writes only units it actually turned off, so that removing Gridline does
# not enable something the administrator had disabled before installing it.
# Each unit is turned off once and then left alone for good. This script runs
# again on every upgrade and on every trigger, and an administrator who enables
# one of these for a session of their own would otherwise find Gridline undoing
# that at the next upgrade, with nothing on the machine explaining why. The
# record is what makes "once" expressible: a unit named in it has been dealt
# with, whatever its state now. A unit absent from it has not, which is also
# what lets a component installed later than Gridline still be caught.
# systemctl --user --global, and not deb-systemd-helper, which this used until
# a check installed and removed the packages and read the machine afterwards.
#
# The helper refuses to re-enable a unit it has no state for, by design: it
# treats the absence of its own record as the administrator having turned the
# unit off deliberately. These three units are enabled by their own packages
# through a path that leaves the helper no state here - measured, no .dsh-also
# file exists for any of them - so the helper disabled them happily and then
# silently declined to put them back. Removing Gridline left a machine with
# three components disabled that had been enabled before it was installed,
# which is the opposite of what package-delivery requires of removal.
#
# The deeper reason is that the helper was never the right tool here. It
# manages the units of the package that calls it, and these belong to three
# other packages. systemctl --user --global is the interface for exactly this:
# machine-wide enablement of a user unit, whoever owns it. It works in both
# directions, says what it did, and needs no state of its own.
#
# Enablement is read as the symlink it is, rather than through the helper's
# was-enabled, which answers only when called from dpkg. The target comes from
# each unit's own [Install] rather than being assumed, because all three happen
# to say graphical-session.target and a fourth need not.
unit_is_enabled() {
    unit=$1
    path=/usr/lib/systemd/user/$unit
    [ -e "$path" ] || return 1
    for target in $(sed -n 's/^WantedBy=//p' "$path" | tr ' ' '\n'); do
        [ -n "$target" ] || continue
        [ -L "/etc/systemd/user/$target.wants/$unit" ] && return 0
    done
    return 1
}

disable_shell_units() {
    for unit in $SHELL_UNITS; do
        [ -e "/usr/lib/systemd/user/$unit" ] || continue
        grep -Fxq "$unit" "$DISABLED_RECORD" 2>/dev/null && continue
        unit_is_enabled "$unit" || continue
        systemctl --user --global disable "$unit" >/dev/null 2>&1 || continue
        mkdir -p "$STATE_DIR"
        echo "$unit" >>"$DISABLED_RECORD"
    done
}

case "$1" in
configure | triggered)
    divert_session_entries
    disable_shell_units
    ;;
abort-upgrade | abort-remove | abort-deconfigure) ;;
*)
    echo "postinst called with unknown argument '$1'" >&2
    exit 1
    ;;
esac

#DEBHELPER#

exit 0
