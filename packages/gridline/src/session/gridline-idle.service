# Idle detection for a Gridline session.
#
# The archive ships no unit for the idle daemon, so this one is Gridline's. It
# is held by gridline-session.target through Upholds= rather than Wants=, and
# that distinction is load-bearing: the session launcher refuses to start when a
# unit the target Wants is not running, and the project records that no idle
# daemon is a blocking component. Upholds keeps it running, and restarts it if
# it stops, without making its absence a reason to refuse a session.
#
# All three events run the same entry point. The timeout is inactivity; the lock
# event is logind's Lock signal, which is what the key binding raises by asking
# logind rather than running a locker; before-sleep is suspend. One path, three
# doors.

[Unit]
Description=Gridline idle detection
PartOf=graphical-session.target
After=graphical-session.target
ConditionEnvironment=WAYLAND_DISPLAY

[Service]
Type=simple
# Each event asks systemd to start the lock rather than running the locker
# here. Running it here is what put the locker inside this unit's cgroup, so a
# stop or a restart of this unit killed a lock in progress; gridline-lock.service
# carries that measurement.
#
# It also fixes before-sleep. Running the locker directly meant swayidle waited
# for it to exit before releasing the sleep inhibitor, which is to say the
# machine waited for the user to authenticate before suspending. Starting a
# unit returns once the unit has started, which is what this event needs.
#
# Starting a unit that is already running is a no-op, so the lock cannot stack:
# the idle timeout can fire while the user is already locked, and the suspend
# hook can fire on top of that.
ExecStart=/usr/bin/swayidle -w \
    timeout 300 'systemctl --user start gridline-lock.service' \
    lock 'systemctl --user start gridline-lock.service' \
    before-sleep 'systemctl --user start gridline-lock.service' \
    idlehint 300
Restart=on-failure
Slice=session.slice
