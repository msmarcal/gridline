#!/bin/sh
# Gridline session launcher.
#
# Establishes the components the session requires before declaring the session
# up. On finding one missing it records which one and returns the seat to the
# display manager, rather than starting a partial session the user cannot
# explain. There is no fallback to another compositor and no retry: a session
# that cannot be what it claims to be hands control back.
#
# The journal identifier below is a contract. add-session-health-check selects
# records by it, so changing it breaks that change.

set -u

JOURNAL_IDENTIFIER=gridline-session
ADAPTER_DIR=/usr/libexec/gridline/adapters
SESSION_TARGET=gridline-session.target

# Report a missing required component on stderr and in the journal, then end
# the launch. stderr reaches the display manager's own log; the journal record
# is what survives for the diagnostics to read.
report_missing() {
    component=$1
    detail=$2
    printf '%s: required component missing: %s (%s)\n' \
        "$JOURNAL_IDENTIFIER" "$component" "$detail" >&2
    if command -v logger >/dev/null 2>&1; then
        logger -t "$JOURNAL_IDENTIFIER" -p daemon.err \
            "required component missing: $component ($detail)"
    fi
    exit 1
}

# Required components, checked in order. The first one missing ends the launch,
# because reporting one cause is more useful than reporting a list the user has
# to read backwards.

# Components the session refuses to start without, beyond what the adapter
# answers for. The adapter reports capabilities, which are statements about the
# compositor: that it implements the lock protocol is not that a locker is
# installed. These are checked here because nothing else will. The archive's
# units for them carry Restart=on-failure, so a missing or failing one restarts
# quietly and systemd lets the session come up regardless.
#
# Absolute paths rather than names resolved through PATH: one of these installs
# outside PATH, and what matters is that the component is installed rather than
# that a name resolves in whatever environment the display manager handed over.
REQUIRED_COMPONENTS="/usr/bin/swaylock
/usr/libexec/hyprpolkitagent"

for component in $REQUIRED_COMPONENTS; do
    [ -x "$component" ] && continue
    report_missing "session component" \
        "$(basename "$component") is not installed at $component"
done

if [ ! -d "$ADAPTER_DIR" ]; then
    report_missing "compositor adapter" \
        "no adapter directory at $ADAPTER_DIR"
fi

adapter=
for candidate in "$ADAPTER_DIR"/*/adapter; do
    [ -x "$candidate" ] || continue
    adapter=$candidate
    break
done

if [ -z "$adapter" ]; then
    report_missing "compositor adapter" \
        "no executable adapter under $ADAPTER_DIR"
fi

# Capabilities the session refuses to start without. This list is a second copy
# of the required table in docs/compositor-adapter.md, because a shell launcher
# cannot read that document at runtime. The tasks require comparing the two.
REQUIRED_CAPABILITIES="compositor-launch output-management
input-configuration window-control lock-signaling idle-reporting screencast
shutdown"

# Phase one. What the adapter can establish from installed files, before
# anything starts. Its answer is not the gate for required capabilities, because
# absence here means not yet establishable. Its exit status is the gate: an
# adapter that already knows it cannot proceed says so while nothing is running.
if ! "$adapter" capabilities >/dev/null 2>&1; then
    report_missing "compositor adapter" \
        "$adapter could not report what it provides"
fi

# Phase two. Start the compositor through the adapter, so this launcher never
# names one. Supporting a second compositor stays a question of which adapter is
# active, which is what the isolation requirement asks of everything out here.
"$adapter" start &
compositor_pid=$!

# Phase three. Ask the running compositor what it actually provides. A reported
# capability needs a documented interface behind it, and before the compositor
# runs there is nothing to ask.
reported=$("$adapter" confirm 2>/dev/null) || reported=

stop_compositor() {
    kill "$compositor_pid" 2>/dev/null
    wait "$compositor_pid" 2>/dev/null
}

stop_session() {
    systemctl --user stop "$SESSION_TARGET" 2>/dev/null
    stop_compositor
}

for required in $REQUIRED_CAPABILITIES; do
    found=no
    for got in $reported; do
        [ "$got" = "$required" ] && { found=yes; break; }
    done
    if [ "$found" = no ]; then
        stop_compositor
        report_missing "compositor capability" \
            "$required was not reported by $adapter"
    fi
done

# The name of the Wayland socket, for the systemd user manager. The manager
# inherits nothing from the display manager, and the archive's units for the
# session components carry ConditionEnvironment=WAYLAND_DISPLAY: with the
# variable unset they are skipped as unsatisfied rather than failed, which is
# the quietest way there is for a blocking component not to start.
#
# The socket name follows the Wayland convention, wayland-N in XDG_RUNTIME_DIR,
# which is freedesktop's and belongs to no compositor. The adapter knows it too,
# but its wire format is a list of capabilities, and widening that to carry
# environment would move session plumbing into the compositor-specific layer.
wayland_display() {
    for socket in "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"/wayland-[0-9]*; do
        [ -S "$socket" ] || continue
        basename "$socket"
        return 0
    done
    return 1
}

# Phase four. Bring up the session's own target, which is what wants the
# components that run for the session's lifetime. It is started here rather than
# before the compositor because the units it wants are conditioned on a Wayland
# display that does not exist until the compositor is up and confirmed.
display=$(wayland_display) || {
    stop_compositor
    report_missing "session component" \
        "no Wayland socket in ${XDG_RUNTIME_DIR:-/run/user/$(id -u)} after the compositor confirmed itself"
}

systemctl --user set-environment "WAYLAND_DISPLAY=$display" 2>/dev/null
systemctl --user import-environment XDG_CURRENT_DESKTOP XDG_SESSION_TYPE 2>/dev/null

if ! systemctl --user start "$SESSION_TARGET" 2>/dev/null; then
    stop_compositor
    report_missing "session target" \
        "$SESSION_TARGET did not start, so nothing wants the session components"
fi

# The target wants its components rather than requiring them, because a target
# that fails takes graphical-session.target and the rest of the session down
# with it. So systemd brings the session up whether or not they started, and
# whether that is acceptable is decided here, with the component named.
#
# This reads unit state, which the pre-flight check above deliberately does not.
# The two answer different questions at different times: before anything runs,
# unit state is no evidence a component is installed, because a unit that
# restarts on failure looks alive either way. After the target has been started,
# unit state is the only thing that says whether the component is running.
#
# The list is read back from the target instead of repeated here, so the units
# the session depends on are declared in exactly one place.
for unit in $(systemctl --user show -p Wants --value "$SESSION_TARGET" 2>/dev/null); do
    systemctl --user is-active --quiet "$unit" && continue
    stop_session
    report_missing "session component" \
        "$unit is installed but is not running after $SESSION_TARGET started"
done

wait "$compositor_pid"
compositor_status=$?

# The session ended. Stopping the target stops graphical-session.target with it,
# through BindsTo, and that stops everything PartOf it. A session that ends
# leaves nothing of itself running for the next one to inherit.
systemctl --user stop "$SESSION_TARGET" 2>/dev/null
systemctl --user unset-environment WAYLAND_DISPLAY 2>/dev/null

exit "$compositor_status"
