#!/bin/sh
# The session's one lock entry point, and the ExecStart of gridline-lock.service.
#
# Everything that locks a Gridline session arrives here, and now arrives by
# starting that unit: the idle timeout, the suspend hook, and the key binding,
# which asks logind to lock rather than running a locker so that a request from
# anywhere on the system takes the same route.
#
# It became a unit's ExecStart rather than something the idle daemon runs,
# because as a child of that daemon the locker lived in its cgroup and died
# with it. Measured: stopping the idle unit killed a running locker and left
# the session locked with nothing to type into. session-manageability requires that lock policy be one policy rather
# than several components configured independently, and this change does not
# build that policy layer, but it should not build something the layer has to
# undo first.
#
# What this adds over running the locker directly is the one thing the locker
# does not do: telling logind that the session is locked. Measured on the
# baseline, swaylock sets nothing, and the session read LockedHint=no through
# two separate lock verifications while the compositor was genuinely locked.
# Anything that acts on the system's view of lock state disagreed with the
# compositor for the whole of it.

set -u

LOCKER=/usr/bin/swaylock
ADAPTER_DIR=/usr/libexec/gridline/adapters
STATE_RECORDER=/usr/libexec/gridline/gridline-component-state
SESSION_OBJECT=/org/freedesktop/login1/session/auto
SESSION_IFACE=org.freedesktop.login1.Session

# auto, not self. This runs under the systemd user manager, which belongs to no
# login session, and there self is an unknown object: measured from inside a
# user unit, self fails outright while auto resolves to the graphical session.
# auto is logind's alias for the caller's session if it has one and the user's
# display session otherwise, which is exactly this case. An earlier version used
# self because a probe run as a child of the compositor, which is in the
# session, resolved it fine. The probe was in the wrong context, not the
# alias in the wrong place.
#
# Errors are reported rather than discarded. The first version silenced busctl
# entirely, so when the call failed the session locked, the hint stayed false,
# and nothing anywhere said why.
set_locked_hint() {
    if ! busctl call org.freedesktop.login1 "$SESSION_OBJECT" "$SESSION_IFACE" \
        SetLockedHint b "$1" >/dev/null 2>&1; then
        printf 'gridline-lock: could not set LockedHint to %s\n' "$1" >&2
        logger -t gridline-lock -p daemon.err \
            "could not set LockedHint to $1 on $SESSION_OBJECT" 2>/dev/null
        return 1
    fi
}

# A second locker over the first would stack: the idle timeout can fire while
# the user is already locked, and the suspend hook can fire on top of that.
#
# systemd now prevents that on the way in, because starting an active unit is a
# no-op, so this guard covers the case systemd does not: someone running this
# program by hand while the unit holds a locker.
if pgrep -x "$(basename "$LOCKER")" >/dev/null 2>&1; then
    exit 0
fi

# What the session knows about the locker, written where the diagnostic reads
# it. A record and never a gate: the recording must not be what decides whether
# a screen gets locked, so every call tolerates failure.
#
# This file records the two things the unit's ExecStopPost cannot see. That the
# locker is not installed at all, which is a different answer from a locker
# that failed and sends a reader somewhere else. And that the screen is about
# to be held, which is the only moment at which running is true of a component
# that spends most of a session not running.
record_locker() {
    [ -x "$STATE_RECORDER" ] || return 0
    GRIDLINE_COMPONENT_BLOCKING=yes \
        "$STATE_RECORDER" record locker "$1" "${2-}" 2>/dev/null || true
}

if [ ! -x "$LOCKER" ]; then
    record_locker absent "$LOCKER"
    printf 'gridline-lock: %s is not installed\n' "$LOCKER" >&2
    logger -t gridline-lock -p daemon.err "locker missing at $LOCKER" 2>/dev/null
    exit 1
fi

# Cleared on every exit path, including a locker that fails to start and one
# killed from outside. A hint left true is worse than one never set: the system
# would believe an unlocked session is locked, which is the failure this
# ordering exists to prevent rather than a tidiness concern.
#
# What the comment above did not anticipate is that the compositor keeps the
# session locked when the locking client dies, so clearing the hint is right
# for a different reason than tidiness: the system then believes a locked
# session is unlocked, which is the direction that leaves it protected, and
# platform-integration requires exactly that.
trap 'set_locked_hint false' EXIT INT TERM

set_locked_hint true
record_locker started
"$LOCKER"
locker_status=$?

# A locker that exits does not mean the session was unlocked, and this is the
# thing that cost a user their machine more than once.
#
# Measured: the locker exits with success both when somebody authenticates and
# when it leaves on its own, so its status cannot tell the two apart. What does
# tell them apart is whether the screen is still locked afterwards. The session
# lock belongs to the compositor, which keeps holding it when its client goes
# away, so the compositor is what gets asked.
#
# It is asked through the adapter, in Gridline's words rather than the
# compositor's, because compositor-abstraction confines that vocabulary to the
# adapter layer and this file is not in it.
#
# Exiting non-zero here is the whole mechanism: the unit carries
# Restart=on-failure, so a session still locked with no locker gets another
# one, and the unit's start limit stops that becoming a loop when it cannot
# converge. No timeout is guessed at and no heuristic decides.
# Found the way the launcher finds it, so there is one shape for this and not
# two that can disagree about which adapter is active.
adapter=
for candidate in "$ADAPTER_DIR"/*/adapter; do
    [ -x "$candidate" ] || continue
    adapter=$candidate
    break
done

# An adapter that cannot answer is not an adapter that said no. The condition
# below restarts only on a definite yes, so a compositor that has gone away at
# the end of a session leaves the lock alone rather than being restarted into
# a session that is closing.
if [ -n "$adapter" ] && "$adapter" session-locked 2>/dev/null; then
    printf 'gridline-lock: the locker exited while the session is still locked\n' >&2
    logger -t gridline-lock -p daemon.err \
        "locker exited with status $locker_status while the session is still locked" 2>/dev/null
    exit 1
fi

exit "$locker_status"
