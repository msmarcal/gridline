#!/usr/bin/make -f

%:
	dh $@

# No two binary packages may ship the same file or declare the same directory.
#
# The gate runs immediately before dh_builddeb, which is the first point where
# every staging tree is complete. Anchoring it earlier leaves it blind: helpers
# that run after the anchor stage files it never sees. dh_installdocs alone
# adds the changelog and copyright that Debian policy requires, so a gate
# placed at dh_install reports zero files while six are about to ship.
# Compositor-specific content may exist only inside the adapter layer. Anchored
# at the same stage as the ownership gate, so there is one answer to when the
# gates run rather than two.
# The portal mapping is assembled from the adapters present in the tree, so the
# compositor backend each one serves stays inside the isolation boundary. It is
# generated before dh_install because that is the helper that stages it.
execute_before_dh_install:
	tools/generate-portals-conf debian/generated/gridline-portals.conf

# The maintainer script acts on the compositor package by name, which is
# compositor-specific logic and so is declared by the adapter rather than
# written into debian/. Same reason and same shape as the portal mapping above.
execute_before_dh_installdeb:
	tools/generate-maintainer-scripts src/config/gridline-session.postinst.in \
		debian/gridline-session.postinst

# One entry point, and this file no longer holds the list.
#
# It did, and the list would have been copied the moment anything else needed
# to run the same checks - which is what an automated run is. Two lists is one
# list that goes stale, and the copy nobody reads is the one that stops
# matching: a check added here and not there would be a check the automated run
# silently stops making.
#
# --require-all because a build has a staging tree, so every check can answer,
# and a check that could not would mean the anchor below is wrong rather than
# that the check is optional.
execute_before_dh_builddeb:
	tools/run-checks --require-all debian
