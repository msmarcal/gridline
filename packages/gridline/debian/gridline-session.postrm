#!/bin/sh
# Give back every session entry this package diverted.
#
# This is the half that matters. A postinst that fails produces an install
# error, which is loud. A postrm that fails leaves an archive package's file
# relocated on a machine Gridline is no longer on, which is silent and is a
# worse state than the one the diversion was introduced to fix.
#
# What to undo is read back from dpkg rather than from a list this package
# wrote. dpkg-divert knows exactly which diversions belong here, so the removal
# undoes what was done rather than what someone remembered to record, and there
# is no second copy of the same fact to fall out of step.

set -e

DIVERTED_SUFFIX=.gridline-diverted

restore_session_entries() {
    dpkg-divert --list "*$DIVERTED_SUFFIX" |
        while read -r _ _ original _ _ _ owner; do
            [ "$owner" = "gridline-session" ] || continue
            dpkg-divert --package gridline-session \
                --rename --remove "$original" >/dev/null
        done
}

STATE_DIR=/var/lib/gridline
DISABLED_RECORD=$STATE_DIR/disabled-user-units

# Enable again what the install disabled, and nothing else.
#
# The postinst turned off the shell components' own enable symlinks, which
# their packages create and which would otherwise start them in every
# graphical session on the machine. Those packages are still installed after
# Gridline is removed, and on a machine without Gridline their own packaging
# decision is theirs to keep.
#
# The record is read rather than the unit list, for the reason the postinst
# states: only units this package actually turned off are listed, so a unit the
# administrator had disabled before installing Gridline stays disabled.
#
# Failures here are tolerated per unit rather than aborting. A package removal
# that stops halfway leaves a machine in a state nobody chose, and an enable
# that did not happen is recoverable by hand while a half-removed package is
# the worse outcome. The diversion above is the opposite case and is not
# tolerated: a relocated file nobody can find is not recoverable by hand.
# systemctl --user --global, and not deb-systemd-helper, which this used and
# which did nothing. Measured by installing and removing the packages on a
# clean machine and reading the enablement afterwards: three units enabled
# before, three disabled after, and not a word anywhere about it.
#
# The helper refuses to re-enable a unit it holds no state for, treating that
# as the administrator's deliberate choice. These three are enabled by their
# own packages through a path that leaves it no state, so it declined - and
# the tolerated failure above, which exists for good reasons, is what made the
# refusal silent.
restore_shell_units() {
    [ -r "$DISABLED_RECORD" ] || return 0
    while IFS= read -r unit; do
        [ -n "$unit" ] || continue
        systemctl --user --global enable "$unit" >/dev/null 2>&1 || true
    done <"$DISABLED_RECORD"
    rm -f "$DISABLED_RECORD"
}

case "$1" in
remove | purge | disappear)
    restore_session_entries
    restore_shell_units
    ;;
upgrade | failed-upgrade | abort-install | abort-upgrade) ;;
*)
    echo "postrm called with unknown argument '$1'" >&2
    exit 1
    ;;
esac

#DEBHELPER#

exit 0
