#!/bin/sh
# Give back every session entry this package diverted.
#
# This is the half that matters. A postinst that fails produces an install
# error, which is loud. A postrm that fails leaves an archive package's file
# relocated on a machine Gridline is no longer on, which is silent and is a
# worse state than the one the diversion was introduced to fix.
#
# What to undo is read back from dpkg rather than from a list this package
# wrote. dpkg-divert knows exactly which diversions belong here, so the removal
# undoes what was done rather than what someone remembered to record, and there
# is no second copy of the same fact to fall out of step.

set -e

DIVERTED_SUFFIX=.gridline-diverted

restore_session_entries() {
    dpkg-divert --list "*$DIVERTED_SUFFIX" |
        while read -r _ _ original _ _ _ owner; do
            [ "$owner" = "gridline-session" ] || continue
            dpkg-divert --package gridline-session \
                --rename --remove "$original" >/dev/null
        done
}

case "$1" in
remove | purge | disappear)
    restore_session_entries
    ;;
upgrade | failed-upgrade | abort-install | abort-upgrade) ;;
*)
    echo "postrm called with unknown argument '$1'" >&2
    exit 1
    ;;
esac

#DEBHELPER#

exit 0
