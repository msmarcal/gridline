#!/bin/sh
# Compositor-specific content may exist only inside the adapter layer.
#
# The path decides, never a reviewer. A file is adapter content because of where
# it is, so a compositor-specific component that needs to exist belongs inside
# the path, and one that cannot move inside it is a design problem this check is
# correctly surfacing.
#
# Scope is src/ and tools/: the content Gridline ships and the programs that
# build it. Two kinds of file are out of scope, both by rule rather than by a
# judgment about any particular file.
#
# debian/ is out because packaging metadata must name the packages the project
# depends on, and a Depends on a compositor is a dependency the project
# recorded, not compositor logic that leaked out of the adapter.
#
# Desktop entries are out because the display manager composes
# XDG_CURRENT_DESKTOP from their DesktopNames field, and portal backend
# resolution reads that variable. The compositor's name has to be there. See
# docs/architecture.md, which records that the identity comes from the entry and
# that the adapter does not supply it.

set -eu

root=$(dirname "$0")/..
adapter_path=src/adapters
self=tools/check-adapter-isolation

# References that mean compositor-specific content. The list starts from what
# this change introduces; a check whose list is empty passes trivially and
# proves nothing. The change that adds a compositor-specific mechanism extends
# it, and add-ci-vm-smoke-tests re-runs the whole check.
#
# Each reference is matched against a file's name and against its contents, for
# different reasons. Contents catch a program that reaches for a compositor.
# Names catch a configuration file, which is the case contents are blindest to:
# a compositor's configuration is written entirely in that compositor's
# vocabulary and still contains none of these strings.
#
# What neither half catches: a compositor configuration file under a neutral
# name. That is a real gap and the answer to it is not a cleverer pattern. This
# check's rule is that the path decides, so compositor configuration belongs
# inside the adapter path, and docs/component-ownership.md records why that is
# compatible with gridline-config owning the installed file.
references='Hyprland
hyprland
hyprctl
hyprland.conf
ext_session_lock_manager_v1
ext_idle_notifier_v1
zwlr_output_manager_v1
zwlr_screencopy_manager_v1
hyprland_toplevel_export_manager_v1
wp_fractional_scale_manager_v1
zwp_pointer_gestures_v1'

cd "$root"

# One pass. An earlier version scanned twice, printing in the first pass and
# counting in the second, and the counting pass was wrong: with set -e, a
# grep that does not match ends the loop body with a non-zero status and the
# subshell exits at the first file that holds no reference. The summary then
# reported zero while the detail lines above it named a leak, and the build
# passed. Counting and reporting from the same pass removes the possibility.
inside=0
outside=0
hits=0

report=$(mktemp)
trap 'rm -f "$report"' EXIT INT TERM

for file in $(find src tools -type f | sort); do
    case "$file" in
    "$adapter_path"/*) inside=$((inside + 1)); continue ;;
    "$self") continue ;;
    *.desktop) continue ;;
    esac
    outside=$((outside + 1))
    base=$(basename "$file")
    for ref in $references; do
        # Names as well as contents. A compositor's configuration file is the
        # most compositor-specific content this project ships and contains none
        # of these strings: "bind = SUPER, Q, killactive" matches nothing in the
        # list while being entirely this compositor's vocabulary. Checking the
        # name catches the file the content check is blindest to, because such a
        # file has to be named for the compositor that reads it.
        case "$base" in
        *"$ref"*)
            printf 'adapter isolation: %s is named for %s\n' "$file" "$ref" >> "$report"
            continue
            ;;
        esac
        if grep -qw -- "$ref" "$file" 2>/dev/null; then
            printf 'adapter isolation: %s references %s\n' "$file" "$ref" >> "$report"
        fi
    done
done

hits=$(wc -l < "$report")
[ "$hits" -eq 0 ] || cat "$report" >&2

printf 'adapter isolation: %s files inside %s, %s outside, %s references found\n' \
    "$inside" "$adapter_path" "$outside" "$hits"

[ "$hits" -eq 0 ] || {
    printf 'adapter isolation: compositor-specific content outside %s\n' \
        "$adapter_path" >&2
    exit 1
}
