#!/bin/sh
# A drop-in must name the component whose unit it modifies.
#
# The fact is split in two and nothing compared the halves. Each drop-in under
# src/session/dropins/<unit>.service.d/ names a role, and gridline-shell maps a
# role to a binary. A drop-in that named the wrong role would start one
# component under another's unit, with that component's configuration, and
# every symptom would belong to systemd rather than to the typo: the unit would
# be active, its ExecStart would look deliberate, and the component the unit is
# named for would simply never run.
#
# The build is where that is catchable, because both halves are files here and
# neither is a file at runtime: the drop-in is installed under a directory
# named for the unit, so the unit name is the thing the role has to agree with.
#
# There are two kinds of drop-in and they are checkable in different ways.
#
# One replaces ExecStart to route a component's start through gridline-shell.
# For those the role has to agree with the unit directory, which is the check
# above, and the role it records on the way out has to be the same role, since
# a drop-in that starts one component and records another leaves both wrong.
#
# One only records, changing nothing about how its unit runs. The agent's is
# the first. Its role cannot be compared with the unit name, deliberately: the
# record is keyed on the project's word for the component and the unit is named
# by whoever packages it, and `polkit-agent` is supposed not to read as
# `hyprpolkitagent`. What is checkable is that the role is one the launcher
# actually declares. A record written under a name nothing reads is invisible:
# the unit's state would be followed perfectly and the diagnostic would go on
# reading the stale record, which is this change's own defect reintroduced with
# no symptom to notice.
#
# What this does not check: whether the binary the role maps to is the one the
# archive's unit would have run. That is the same question one level down, and
# the unit names its own ExecStart, which is not Gridline's to read from here.
set -eu

root=$(dirname "$0")/..
dropins=src/session/dropins
wrapper=src/session/gridline-shell
launcher=src/session/gridline-session

cd "$root"

report=$(mktemp)
trap 'rm -f "$report"' EXIT INT TERM

checked=0

[ -d "$dropins" ] || {
    printf 'drop-in roles: %s does not exist\n' "$dropins" >&2
    exit 1
}

[ -r "$wrapper" ] || {
    printf 'drop-in roles: %s is not readable\n' "$wrapper" >&2
    exit 1
}

[ -r "$launcher" ] || {
    printf 'drop-in roles: %s is not readable\n' "$launcher" >&2
    exit 1
}

# The component names the launcher declares, which are the names the diagnostic
# reads back. The first field of each REQUIRED_COMPONENTS entry, over the lines
# of that one assignment.
declared_components=$(sed -n '/^REQUIRED_COMPONENTS="/,/"$/ {
    s/^REQUIRED_COMPONENTS="//
    s/"$//
    s/:.*//
    p
}' "$launcher")

[ -n "$declared_components" ] || {
    printf 'drop-in roles: found no component names in %s\n' "$launcher" >&2
    printf 'drop-in roles: the check cannot run without them\n' >&2
    exit 1
}

for directory in "$dropins"/*.service.d; do
    [ -d "$directory" ] || continue

    unit=$(basename "$directory" .service.d)
    conf=$directory/gridline.conf

    [ -r "$conf" ] || {
        printf 'drop-in roles: %s has no readable gridline.conf\n' \
            "$directory" >> "$report"
        continue
    }

    checked=$((checked + 1))

    # The role is the last field of the ExecStart that names the wrapper.
    role=$(sed -n 's|^ExecStart=.*/gridline-shell  *\([A-Za-z-]*\) *$|\1|p' "$conf")

    # The role the drop-in records under, from its ExecStopPost. Both verbs are
    # matched: one unit's component runs on demand and records with finished
    # rather than stopped, and either is a role this has to agree about.
    #
    # The delimiter is # and not |, which is not a style choice: with | as the
    # delimiter the \| of the alternation reads as an escaped delimiter, so the
    # expression matched a literal pipe and every drop-in came back recording
    # nothing. It failed loudly rather than silently only by luck.
    recorded=$(sed -n \
        's#^ExecStopPost=.*/gridline-component-state  *\(stopped\|finished\)  *\([A-Za-z-]*\) *$#\2#p' \
        "$conf")

    # A drop-in that neither starts nor records does nothing this project can
    # check, and is far more likely to be a drop-in that lost a line.
    [ -n "$role" ] || [ -n "$recorded" ] || {
        printf 'drop-in roles: %s names no role, through neither ExecStart nor ExecStopPost\n' \
            "$conf" >> "$report"
        continue
    }

    # Every drop-in records, whether or not it starts anything. A component
    # followed by nothing is the defect that made the diagnostic report a dead
    # authentication agent as running for a whole session.
    [ -n "$recorded" ] || {
        printf 'drop-in roles: %s starts role %s and records nothing when it ends\n' \
            "$conf" "$role" >> "$report"
        continue
    }

    # The record-only kind. Its role is checked against the names the launcher
    # declares rather than against the unit directory, for the reason at the
    # top of this file: the two are deliberately different words.
    if [ -z "$role" ]; then
        if ! printf '%s\n' "$declared_components" | grep -Fxq "$recorded"; then
            printf 'drop-in roles: %s records role %s, which %s does not declare\n' \
                "$conf" "$recorded" "$launcher" >> "$report"
        fi
        continue
    fi

    # The start-and-record kind. One role, named twice, and the two have to be
    # the same one.
    [ "$recorded" = "$role" ] || {
        printf 'drop-in roles: %s starts role %s and records role %s\n' \
            "$conf" "$role" "$recorded" >> "$report"
        continue
    }

    # What the wrapper runs for that role: the binary= assignment inside the
    # matching case branch.
    binary=$(awk -v role="$role" '
        $0 ~ "^" role "\\)" { inside = 1; next }
        inside && /^[a-z]*\)$/ { inside = 0 }
        inside && /^ *binary=/ { sub(/^ *binary=/, ""); print; exit }
    ' "$wrapper")

    [ -n "$binary" ] || {
        printf 'drop-in roles: %s names role %s, which %s does not handle\n' \
            "$conf" "$role" "$wrapper" >> "$report"
        continue
    }

    [ "$(basename "$binary")" = "$unit" ] || {
        printf 'drop-in roles: %s modifies %s.service but role %s runs %s\n' \
            "$conf" "$unit" "$role" "$binary" >> "$report"
    }
done

hits=$(wc -l < "$report")
[ "$hits" -eq 0 ] || cat "$report" >&2

printf 'drop-in roles: %s checked, %s not matching their unit\n' "$checked" "$hits"

[ "$hits" -eq 0 ] || {
    printf 'drop-in roles: a drop-in must start the component its unit names\n' >&2
    exit 1
}
